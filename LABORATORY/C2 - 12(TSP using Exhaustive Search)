#include<stdio.h>
#include<math.h>
#define N 5
typedef struct{double x,y;}City;
double distance(City a,City b){
return sqrt((a.x-b.x)*(a.x-b.x)+(a.y-b.y)*(a.y-b.y));
}
void swap(int*a,int*b){
int t=*a;*a=*b;*b=t;
}
void tsp(City c[],int n,int a[],int l,double *min,int best[]){
int i;
if(l==n){
double d=0;
for(i=0;i<n-1;i++)d+=distance(c[a[i]],c[a[i+1]]);
d+=distance(c[a[n-1]],c[a[0]]);
if(d<*min){
*min=d;
for(i=0;i<n;i++)best[i]=a[i];
}
return;
}
for(i=l;i<n;i++){
swap(&a[l],&a[i]);
tsp(c,n,a,l+1,min,best);
swap(&a[l],&a[i]);
}
}
int main(){
City c1[]={{1,2},{4,5},{7,1},{3,6}};
City c2[]={{2,4},{8,1},{1,7},{6,3},{5,9}};
City *sets[]={c1,c2};
int ns[]={4,5},s,a[N]={0},best[N];
for(s=0;s<2;s++){
double min=999999;
tsp(sets[s],ns[s],a,1,&min,best);
printf("Test Case %d:\nShortest Distance: %.6f\nPath: ",s+1,min);
for(int i=0;i<ns[s];i++)
printf("(%.0f,%.0f) ",sets[s][best[i]].x,sets[s][best[i]].y);
printf("(%.0f,%.0f)\n",sets[s][best[0]].x,sets[s][best[0]].y);
}
return 0;
}
