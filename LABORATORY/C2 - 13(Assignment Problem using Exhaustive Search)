#include<stdio.h>
#define N 3
int cost[N][N],best[N],perm[N],used[N],min;
void solve(int row,int total){
int j;
if(row==N){
if(total<min){
min=total;
for(j=0;j<N;j++)best[j]=perm[j];
}
return;
}
for(j=0;j<N;j++){
if(!used[j]){
used[j]=1;
perm[row]=j;
solve(row+1,total+cost[row][j]);
used[j]=0;
}
}
}
void run(int c[N][N]){
int i,j;
for(i=0;i<N;i++)
for(j=0;j<N;j++)
cost[i][j]=c[i][j];
min=99999;
for(i=0;i<N;i++)used[i]=0;
solve(0,0);
printf("Optimal Assignment: ");
for(i=0;i<N;i++)
printf("(worker %d, task %d) ",i+1,best[i]+1);
printf("\nTotal Cost: %d\n",min);
}
int main(){
int a[N][N]={{3,10,7},{8,5,12},{4,6,9}};
int b[N][N]={{15,9,4},{8,7,18},{6,12,11}};
run(a);
run(b);
return 0;
}
