#include <stdio.h>

int main() {
    int nums[] = {-10, 2, 3, -4, 5};   // Change the array for other test cases
    int n = sizeof(nums) / sizeof(nums[0]);

    int max = nums[0];

    for (int i = 1; i < n; i++) {
        if (nums[i] > max) {
            max = nums[i];
        }
    }

    printf("Maximum Element = %d", max);

    return 0;
}
