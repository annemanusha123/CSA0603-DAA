#include<stdio.h>
typedef struct{int x,y;}Point;
int cross(Point a,Point b,Point c){
return(b.x-a.x)*(c.y-a.y)-(b.y-a.y)*(c.x-a.x);
}
int main(){
Point p[]={{1,1},{4,6},{8,1},{0,0},{3,3}};
int n=5,i,j,k,left,right;
printf("Convex Hull: ");
for(i=0;i<n;i++){
for(j=i+1;j<n;j++){
left=right=0;
for(k=0;k<n;k++){
if(k==i||k==j)continue;
if(cross(p[i],p[j],p[k])>0)left=1;
if(cross(p[i],p[j],p[k])<0)right=1;
}
if(!(left&&right)){
printf("(%d,%d) ",p[i].x,p[i].y);
printf("(%d,%d) ",p[j].x,p[j].y);
}
}
}
return 0;
}
