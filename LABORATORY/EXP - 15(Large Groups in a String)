#include <stdio.h>
#include <string.h>

int main() {
    char s[] = "abbxxxxzzy";
    int n = strlen(s);

    printf("Large groups: ");

    int i = 0;

    while (i < n) {
        int start = i;

        while (i + 1 < n && s[i] == s[i + 1]) {
            i++;
        }

        int end = i;

        if (end - start + 1 >= 3) {
            printf("[%d,%d] ", start, end);
        }

        i++;
    }

    return 0;
}
