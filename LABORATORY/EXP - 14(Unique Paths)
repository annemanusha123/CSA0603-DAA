#include <stdio.h>

int main() {
    int m = 7, n = 3;
    int dp[n];

    for (int i = 0; i < n; i++)
        dp[i] = 1;

    for (int i = 1; i < m; i++) {
        for (int j = 1; j < n; j++) {
            dp[j] = dp[j] + dp[j - 1];
        }
    }

    printf("Number of unique paths = %d", dp[n - 1]);

    return 0;
}
