#include <stdio.h>

int main() {
    int n = 4;
    int a = 1, b = 1, c;

    if (n == 0 || n == 1) {
        printf("Number of ways = 1");
        return 0;
    }

    for (int i = 2; i <= n; i++) {
        c = a + b;
        a = b;
        b = c;
    }

    printf("Number of ways = %d", b);

    return 0;
}
