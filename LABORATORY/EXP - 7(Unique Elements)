#include <stdio.h>

int main() {
    int arr[] = {3, 7, 3, 5, 2, 5, 9, 2};
    int n = 8;

    int unique[n];
    int count = 0;

    for (int i = 0; i < n; i++) {
        int found = 0;

        for (int j = 0; j < count; j++) {
            if (arr[i] == unique[j]) {
                found = 1;
                break;
            }
        }

        if (!found) {
            unique[count] = arr[i];
            count++;
        }
    }

    printf("Unique Elements: [");
    for (int i = 0; i < count; i++) {
        printf("%d", unique[i]);
        if (i < count - 1)
            printf(", ");
    }
    printf("]");

    return 0;
}
