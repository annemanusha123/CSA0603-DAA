#include <stdio.h>

int countWays(int m, int n, int N, int i, int j) {
    if (i < 0 || i >= m || j < 0 || j >= n)
        return 1;

    if (N == 0)
        return 0;

    return countWays(m, n, N - 1, i - 1, j) +
           countWays(m, n, N - 1, i + 1, j) +
           countWays(m, n, N - 1, i, j - 1) +
           countWays(m, n, N - 1, i, j + 1);
}

int main() {
    int m = 2, n = 2, N = 2;
    int i = 0, j = 0;

    printf("Number of ways = %d", countWays(m, n, N, i, j));

    return 0;
}
