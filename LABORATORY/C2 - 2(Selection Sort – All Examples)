#include<stdio.h>
void sort(int a[],int n){
int i,j,m,t;
for(i=0;i<n-1;i++){
m=i;
for(j=i+1;j<n;j++)
if(a[j]<a[m])m=j;
t=a[i];a[i]=a[m];a[m]=t;
}
}
void print(int a[],int n){
int i;
for(i=0;i<n;i++)printf("%d ",a[i]);
printf("\n");
}
int main(){
int a[]={5,2,9,1,5,6};
int b[]={10,8,6,4,2};
int c[]={1,2,3,4,5};
sort(a,6);sort(b,5);sort(c,5);
print(a,6);print(b,5);print(c,5);
return 0;
}
