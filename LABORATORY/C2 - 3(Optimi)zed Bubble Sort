#include<stdio.h>
void bubble(int a[],int n){
int i,j,t,sw;
for(i=0;i<n-1;i++){
sw=0;
for(j=0;j<n-i-1;j++){
if(a[j]>a[j+1]){
t=a[j];a[j]=a[j+1];a[j+1]=t;
sw=1;
}
}
if(!sw)break;
}
}
void print(int a[],int n){
int i;
for(i=0;i<n;i++)printf("%d ",a[i]);
printf("\n");
}
int main(){
int a[]={64,25,12,22,11};
int b[]={29,10,14,37,13};
int c[]={3,5,2,1,4};
int d[]={1,2,3,4,5};
int e[]={5,4,3,2,1};
bubble(a,5);bubble(b,5);bubble(c,5);bubble(d,5);bubble(e,5);
print(a,5);print(b,5);print(c,5);print(d,5);print(e,5);
return 0;
}
