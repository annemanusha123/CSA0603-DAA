#include <stdio.h>

int main() {
    int arr[] = {3, 4, 6, 8, 9, 10, 30};
    int n = 7;
    int key = 10;

    int low = 0, high = n - 1;
    int found = 0, position = -1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (arr[mid] == key) {
            found = 1;
            position = mid;
            break;
        }
        else if (arr[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    if (found)
        printf("Element %d is found at position %d", key, position + 1);
    else
        printf("Element %d is not found", key);

    return 0;
}
