#include <stdio.h>

#define MAX 100

int main() {
    int poured = 2;
    int query_row = 1;
    int query_glass = 1;

    double tower[MAX][MAX] = {0};

    tower[0][0] = poured;

    for (int i = 0; i < 99; i++) {
        for (int j = 0; j <= i; j++) {

            if (tower[i][j] > 1.0) {
                double excess = (tower[i][j] - 1.0) / 2.0;

                tower[i + 1][j] += excess;
                tower[i + 1][j + 1] += excess;

                tower[i][j] = 1.0;
            }
        }
    }

    double result = tower[query_row][query_glass];

    if (result > 1.0)
        result = 1.0;

    printf("%.5f\n", result);

    return 0;
}
