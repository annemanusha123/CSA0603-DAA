#include<stdio.h>
int n,w[10],v[10],cap,best,bestmask;
void solve(int i,int weight,int value,int mask){
if(i==n){
if(weight<=cap&&value>best){
best=value;
bestmask=mask;
}
return;
}
solve(i+1,weight,value,mask);
solve(i+1,weight+w[i],value+v[i],mask|(1<<i));
}
void run(int W[],int V[],int N,int C){
int i;
n=N;
cap=C;
best=0;
bestmask=0;
for(i=0;i<n;i++){
w[i]=W[i];
v[i]=V[i];
}
solve(0,0,0,0);
printf("Optimal Selection: [");
for(i=0;i<n;i++)
if(bestmask&(1<<i))
printf("%d ",i);
printf("]\nTotal Value: %d\n",best);
}
int main(){
int w1[]={2,3,1},v1[]={4,5,3};
int w2[]={1,2,3,4},v2[]={2,4,6,3};
run(w1,v1,3,4);
run(w2,v2,4,6);
return 0;
}
