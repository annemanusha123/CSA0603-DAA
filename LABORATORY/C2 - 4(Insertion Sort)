#include<stdio.h>
void sort(int a[],int n){
int i,j,k;
for(i=1;i<n;i++){
k=a[i];j=i-1;
while(j>=0&&a[j]>k){
a[j+1]=a[j];j--;
}
a[j+1]=k;
}
}
void print(int a[],int n){
int i;
for(i=0;i<n;i++)printf("%d ",a[i]);
printf("\n");
}
int main(){
int a[]={3,1,4,1,5,9,2,6,5,3};
int b[]={5,5,5,5,5};
int c[]={2,3,1,3,2,1,1,3};
sort(a,10);sort(b,5);sort(c,8);
print(a,10);print(b,5);print(c,8);
return 0;
}
