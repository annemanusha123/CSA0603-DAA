#include<stdio.h>
void sort(int a[],int n){
int i,j,m,t;
for(i=0;i<n-1;i++){
m=i;
for(j=i+1;j<n;j++)
if(a[j]<a[m])m=j;
t=a[i];a[i]=a[m];a[m]=t;
}
}
void print(int a[],int n){
int i;
printf("[");
for(i=0;i<n;i++){
printf("%d",a[i]);
if(i<n-1)printf(", ");
}
printf("]\n");
}
int main(){
int a[]={-5,-1,-3,-2,-4};
sort(a,5);
print(a,5);
return 0;
}
